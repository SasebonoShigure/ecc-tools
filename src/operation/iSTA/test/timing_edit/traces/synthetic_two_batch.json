0 0.95 0.60 ;\n    END\n  END Y\nEND BUF_X1\n\nMACRO OR2_X1\n  CLASS CORE ;\n  ORIGIN 0 0 ;\n  SIZE 1.2 BY 1.0 ;\n  SYMMETRY X Y ;\n  SITE CoreSite ;\n  PIN A\n    DIRECTION INPUT ;\n    USE SIGNAL ;\n    PORT\n      LAYER M1 ;\n      RECT 0.05 0.20 0.15 0.35 ;\n    END\n  END A\n  PIN B\n    DIRECTION INPUT ;\n    USE SIGNAL ;\n    PORT\n      LAYER M1 ;\n      RECT 0.05 0.65 0.15 0.80 ;\n    END\n  END B\n  PIN Y\n    DIRECTION OUTPUT ;\n    USE SIGNAL ;\n    PORT\n      LAYER M1 ;\n      RECT 1.05 0.40 1.15 0.60 ;\n    END\n  END Y\nEND OR2_X1\n\nEND LIBRARY\n"},"liberty":{"logical_name":"stage4.lib","source_text":"library (stage4_buffer_lib) {\n  time_unit : \"1ns\";\n  voltage_unit : \"1V\";\n  current_unit : \"1mA\";\n  pulling_resistance_unit : \"1kohm\";\n  capacitive_load_unit (1, pf);\n  leakage_power_unit : \"1nW\";\n  nom_process : 1.0;\n  nom_temperature : 25.0;\n  nom_voltage : 1.0;\n  slew_lower_threshold_pct_rise : 30.0;\n  slew_upper_threshold_pct_rise : 70.0;\n  slew_lower_threshold_pct_fall : 30.0;\n  slew_upper_threshold_pct_fall : 70.0;\n  input_threshold_pct_rise : 50.0;\n  output_threshold_pct_rise : 50.0;\n  input_threshold_pct_fall : 50.0;\n  output_threshold_pct_fall : 50.0;\n  slew_derate_from_library : 1.0;\n\n  operating_conditions (typical) {\n    process : 1.0;\n    temperature : 25.0;\n    voltage : 1.0;\n  }\n  default_operating_conditions : typical;\n\n  lu_table_template (delay_template) {\n    variable_1 : input_net_transition;\n    variable_2 : total_output_net_capacitance;\n    index_1 (\"0.01, 0.10\");\n    index_2 (\"0.001, 0.020\");\n  }\n\n  cell (BUF_X1) {\n    area : 1.0;\n    cell_leakage_power : 0.001;\n    pin (A) {\n      direction : input;\n      capacitance : 0.001;\n      rise_capacitance : 0.001;\n      fall_capacitance : 0.001;\n    }\n    pin (Y) {\n      direction : output;\n      function : \"A\";\n      max_capacitance : 0.100;\n      timing () {\n        related_pin : \"A\";\n        timing_sense : positive_unate;\n        timing_type : combinational;\n        cell_rise (delay_template) {\n          values (\"0.004, 0.006\", \"0.006, 0.008\");\n        }\n        cell_fall (delay_template) {\n          values (\"0.003, 0.005\", \"0.005, 0.007\");\n        }\n        rise_transition (delay_template) {\n          values (\"0.006, 0.008\", \"0.008, 0.010\");\n        }\n        fall_transition (delay_template) {\n          values (\"0.005, 0.007\", \"0.007, 0.009\");\n        }\n      }\n    }\n  }\n\n  cell (OR2_X1) {\n    area : 1.2;\n    cell_leakage_power : 0.002;\n    pin (A) {\n      direction : input;\n      capacitance : 0.010;\n      rise_capacitance : 0.010;\n      fall_capacitance : 0.010;\n    }\n    pin (B) {\n      direction : input;\n      capacitance : 0.010;\n      rise_capacitance : 0.010;\n      fall_capacitance : 0.010;\n    }\n    pin (Y) {\n      direction : output;\n      function : \"A | B\";\n      max_capacitance : 0.100;\n      timing () {\n        related_pin : \"A\";\n        timing_sense : positive_unate;\n        timing_type : combinational;\n        cell_rise (delay_template) { values (\"0.012, 0.016\", \"0.016, 0.020\"); }\n        cell_fall (delay_template) { values (\"0.011, 0.015\", \"0.015, 0.019\"); }\n        rise_transition (delay_template) { values (\"0.010, 0.014\", \"0.014, 0.018\"); }\n        fall_transition (delay_template) { values (\"0.009, 0.013\", \"0.013, 0.017\"); }\n      }\n      timing () {\n        related_pin : \"B\";\n        timing_sense : positive_unate;\n        timing_type : combinational;\n        cell_rise (delay_template) { values (\"0.012, 0.016\", \"0.016, 0.020\"); }\n        cell_fall (delay_template) { values (\"0.011, 0.015\", \"0.015, 0.019\"); }\n        rise_transition (delay_template) { values (\"0.010, 0.014\", \"0.014, 0.018\"); }\n        fall_transition (delay_template) { values (\"0.009, 0.013\", \"0.013, 0.017\"); }\n      }\n    }\n  }\n}\n"},"sdc":{"logical_name":"design.sdc","source_text":"create_clock -name vclk -period 10.0 [get_ports clk]\nset_input_delay -clock vclk -max 1.0 [get_ports data_in]\nset_input_delay -clock vclk -min 0.2 [get_ports data_in]\nset_input_transition 0.05 [get_ports data_in]\nset_output_delay -clock vclk -max 1.0 [get_ports data_out]\nset_output_delay -clock vclk -min 0.2 [get_ports data_out]\nset_load 0.01 [get_ports data_out]\n"},"tech_lef":{"logical_name":"tech.lef","source_text":"VERSION 5.8 ;\nBUSBITCHARS \"[]\" ;\nDIVIDERCHAR \"/\" ;\n\nUNITS\n  DATABASE MICRONS 1000 ;\nEND UNITS\n\nMANUFACTURINGGRID 0.001 ;\n\nLAYER M1\n  TYPE ROUTING ;\n  DIRECTION HORIZONTAL ;\n  PITCH 0.10 ;\n  WIDTH 0.05 ;\n  SPACING 0.05 ;\nEND M1\n\nLAYER V1\n  TYPE CUT ;\n  SPACING 0.05 ;\nEND V1\n\nLAYER M2\n  TYPE ROUTING ;\n  DIRECTION VERTICAL ;\n  PITCH 0.10 ;\n  WIDTH 0.05 ;\n  SPACING 0.05 ;\nEND M2\n\nEND LIBRARY\n"},"top":"stage4_buffer_two_batch","verilog":{"logical_name":"design.v","source_text":"module stage4_buffer_two_batch(clk, data_in, data_out);\n  input clk;\n  input data_in;\n  output data_out;\n\n  // Both loads begin on one net. Round one moves exactly one load; round two\n  // can then select the created output net as a distinct semantic net.\n  OR2_X1 u0 (.A(data_in), .B(data_in), .Y(data_out));\nendmodule\n"}}}}}
