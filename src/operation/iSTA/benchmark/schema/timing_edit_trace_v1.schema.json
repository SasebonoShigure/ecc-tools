{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openecos.org/schemas/timing_edit_trace_v1.schema.json",
  "title": "iSTA timing edit trace, version 1",
  "description": "Closed-world wire contract emitted and consumed by TimingEditTraceJson. SHA-256 fields are provenance-integrity values: this schema checks their representation only and does not substitute hash checks for functional replay validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workload_kind",
    "seed",
    "profile",
    "baseline",
    "source_artifacts",
    "batches",
    "replay_command"
  ],
  "properties": {
    "schema_version": {"const": "timing-edit-trace/1.0.0"},
    "workload_kind": {"enum": ["synthetic", "real_design"]},
    "seed": {"$ref": "#/$defs/u64"},
    "profile": {"$ref": "#/$defs/nonEmptyText"},
    "baseline": {"$ref": "#/$defs/baselineIdentity"},
    "source_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceArtifact"}
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/batch"}
    },
    "replay_command": {"$ref": "#/$defs/replayCommand"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"workload_kind": {"const": "real_design"}},
        "required": ["workload_kind"]
      },
      "then": {
        "properties": {"source_artifacts": {"minItems": 1}}
      }
    }
  ],
  "$defs": {
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "i32": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "creationToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "case_id",
        "profile_id",
        "seed",
        "batch_ordinal",
        "accepted_ordinal"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "case_id": {"$ref": "#/$defs/nonEmptyText"},
        "profile_id": {"$ref": "#/$defs/nonEmptyText"},
        "seed": {"$ref": "#/$defs/u64"},
        "batch_ordinal": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "accepted_ordinal": {"$ref": "#/$defs/u64"}
      }
    },
    "nodeKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "full_name", "instance_name", "pin_name"],
      "properties": {
        "kind": {"enum": ["port", "instance_pin"]},
        "full_name": {"type": "string", "minLength": 1},
        "instance_name": {"type": "string"},
        "pin_name": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "port"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "instance_name": {"const": ""},
              "pin_name": {"const": ""}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "instance_pin"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "instance_name": {"minLength": 1},
              "pin_name": {"minLength": 1}
            }
          }
        }
      ]
    },
    "timingTableSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "variable1", "variable2"],
      "properties": {
        "present": {"type": "boolean"},
        "variable1": {
          "enum": ["none", "input_transition", "output_capacitance", "constrained_transition"]
        },
        "variable2": {
          "enum": ["none", "input_transition", "output_capacitance", "constrained_transition"]
        }
      }
    },
    "libraryArcSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library_name",
        "arc_index",
        "sense",
        "trigger_transition",
        "check_transition",
        "sdf_condition",
        "delay_tables",
        "slew_tables"
      ],
      "properties": {
        "library_name": {"type": "string"},
        "arc_index": {"$ref": "#/$defs/i32"},
        "sense": {
          "enum": ["none_positive_fallback", "positive_unate", "negative_unate", "non_unate"]
        },
        "trigger_transition": {"enum": ["rise", "fall", "none"]},
        "check_transition": {"enum": ["rise", "fall", "none"]},
        "sdf_condition": {"type": "string"},
        "delay_tables": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/timingTableSignature"}
        },
        "slew_tables": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/timingTableSignature"}
        }
      }
    },
    "arcKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sink",
        "kind",
        "owner_name",
        "library_source_port",
        "library_sink_port",
        "library_arcs",
        "parallel_ordinal"
      ],
      "properties": {
        "source": {"$ref": "#/$defs/nodeKey"},
        "sink": {"$ref": "#/$defs/nodeKey"},
        "kind": {"enum": ["cell", "net"]},
        "owner_name": {"$ref": "#/$defs/nonEmptyText"},
        "library_source_port": {"type": "string"},
        "library_sink_port": {"type": "string"},
        "library_arcs": {
          "type": "array",
          "items": {"$ref": "#/$defs/libraryArcSignature"}
        },
        "parallel_ordinal": {"$ref": "#/$defs/u64"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "net"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "library_source_port": {"const": ""},
              "library_sink_port": {"const": ""},
              "library_arcs": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "cell"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "library_source_port": {"minLength": 1},
              "library_sink_port": {"minLength": 1}
            }
          }
        }
      ]
    },
    "stableNodeRef": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "baseline_key"],
          "properties": {
            "kind": {"const": "existing"},
            "baseline_key": {"$ref": "#/$defs/nodeKey"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "creation_token", "role"],
          "properties": {
            "kind": {"const": "created"},
            "creation_token": {"$ref": "#/$defs/creationToken"},
            "role": {"enum": ["input", "output"]}
          }
        }
      ]
    },
    "stableNetRef": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "baseline_name"],
          "properties": {
            "kind": {"const": "existing"},
            "baseline_name": {"$ref": "#/$defs/nonEmptyText"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "creation_token", "role"],
          "properties": {
            "kind": {"const": "created"},
            "creation_token": {"$ref": "#/$defs/creationToken"},
            "role": {"const": "output_net"}
          }
        }
      ]
    },
    "libraryCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library_name", "cell_name", "input_port", "output_port", "ordered_arc_signatures"],
      "properties": {
        "library_name": {"$ref": "#/$defs/nonEmptyText"},
        "cell_name": {"$ref": "#/$defs/nonEmptyText"},
        "input_port": {"$ref": "#/$defs/nonEmptyText"},
        "output_port": {"$ref": "#/$defs/nonEmptyText"},
        "ordered_arc_signatures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/libraryArcSignature"}
        }
      }
    },
    "placementInputs": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "unplaced"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "x_microns", "y_microns"],
          "properties": {
            "kind": {"const": "placed"},
            "x_microns": {"type": "number"},
            "y_microns": {"type": "number"}
          }
        }
      ]
    },
    "rcInputs": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "no_parasitic"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "policy"],
          "properties": {
            "kind": {"const": "parasitic"},
            "policy": {"enum": ["error", "full_with_record"]}
          }
        }
      ]
    },
    "bufferInsertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_net",
        "moved_sinks",
        "library_cell",
        "placement_inputs",
        "rc_inputs",
        "creation_token"
      ],
      "properties": {
        "original_net": {"$ref": "#/$defs/stableNetRef"},
        "moved_sinks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableNodeRef"}
        },
        "library_cell": {"$ref": "#/$defs/libraryCell"},
        "placement_inputs": {"$ref": "#/$defs/placementInputs"},
        "rc_inputs": {"$ref": "#/$defs/rcInputs"},
        "creation_token": {"$ref": "#/$defs/creationToken"}
      }
    },
    "componentFingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "topology", "clock_constraint", "library", "corner", "parasitic", "timing_input"],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "topology": {"$ref": "#/$defs/sha256"},
        "clock_constraint": {"$ref": "#/$defs/sha256"},
        "library": {"$ref": "#/$defs/sha256"},
        "corner": {"$ref": "#/$defs/sha256"},
        "parasitic": {"$ref": "#/$defs/sha256"},
        "timing_input": {"$ref": "#/$defs/sha256"}
      }
    },
    "canonicalPreState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instances", "nets", "nodes", "arcs"],
      "properties": {
        "instances": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "nets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "nodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nodeKey"}
        },
        "arcs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/arcKey"}
        }
      }
    },
    "baselineIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_name", "fingerprints", "canonical_pre_state"],
      "properties": {
        "design_name": {"$ref": "#/$defs/nonEmptyText"},
        "fingerprints": {"$ref": "#/$defs/componentFingerprints"},
        "canonical_pre_state": {"$ref": "#/$defs/canonicalPreState"}
      }
    },
    "committedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "current_fingerprints", "canonical_pre_state"],
      "properties": {
        "generation": {"$ref": "#/$defs/u64"},
        "current_fingerprints": {"$ref": "#/$defs/componentFingerprints"},
        "canonical_pre_state": {"$ref": "#/$defs/canonicalPreState"}
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_role", "logical_name", "content_sha256"],
      "properties": {
        "artifact_role": {"$ref": "#/$defs/nonEmptyText"},
        "logical_name": {"$ref": "#/$defs/nonEmptyText"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "reasons"],
      "properties": {
        "disposition": {"enum": ["supported", "full_with_record"]},
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "supported"}}, "required": ["disposition"]},
          "then": {"properties": {"reasons": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"disposition": {"const": "full_with_record"}}, "required": ["disposition"]},
          "then": {"properties": {"reasons": {"minItems": 1}}}
        }
      ]
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "expected_pre_identity", "edits", "policy_receipt", "expected_post_identity"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "expected_pre_identity": {"$ref": "#/$defs/committedIdentity"},
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/bufferInsertion"}
        },
        "policy_receipt": {"$ref": "#/$defs/policyReceipt"},
        "expected_post_identity": {"$ref": "#/$defs/committedIdentity"}
      }
    },
    "replayCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments"],
      "properties": {
        "executable": {"$ref": "#/$defs/nonEmptyText"},
        "arguments": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        }
      }
    }
  }
}
