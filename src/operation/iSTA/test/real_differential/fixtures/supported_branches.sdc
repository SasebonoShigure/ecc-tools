create_clock -name vclk_a -period 8.0 [get_ports clk_a]
create_clock -name vclk_b -period 11.0 [get_ports clk_b]
set_input_delay -clock vclk_a -max 0.8 [get_ports data_a]
set_input_delay -clock vclk_a -min 0.1 [get_ports data_a]
set_input_transition 0.04 [get_ports data_a]
set_input_delay -clock vclk_b -max 1.1 [get_ports data_b]
set_input_delay -clock vclk_b -min 0.2 [get_ports data_b]
set_input_transition 0.06 [get_ports data_b]
set_output_delay -clock vclk_a -max 0.7 [get_ports near_out]
set_output_delay -clock vclk_a -min 0.15 [get_ports near_out]
set_load 0.012 [get_ports near_out]
set_output_delay -clock vclk_b -max 0.9 [get_ports secondary_out]
set_output_delay -clock vclk_b -min 0.25 [get_ports secondary_out]
set_load 0.009 [get_ports secondary_out]
