create_clock -name vclk -period 10.0 [get_ports clk]
set_input_delay -clock vclk -max 1.0 [get_ports dummy_in0]
set_input_delay -clock vclk -max 1.0 [get_ports dummy_in1]
set_input_delay -clock vclk -max 1.0 [get_ports dummy_in2]
set_input_delay -clock vclk -max 1.0 [get_ports target_in]
set_input_transition 0.05 [get_ports dummy_in0]
set_input_transition 0.05 [get_ports dummy_in1]
set_input_transition 0.05 [get_ports dummy_in2]
set_input_transition 0.05 [get_ports target_in]
set_output_delay -clock vclk -max 9.0 [get_ports dummy_out0]
set_output_delay -clock vclk -max 9.0 [get_ports dummy_out1]
set_output_delay -clock vclk -max 9.0 [get_ports dummy_out2]
set_output_delay -clock vclk -max 9.0 [get_ports guard_out]
set_output_delay -clock vclk -max 0.1 [get_ports data_out]
set_output_delay -clock vclk -min 0.0 [get_ports dummy_out0]
set_output_delay -clock vclk -min 0.0 [get_ports dummy_out1]
set_output_delay -clock vclk -min 0.0 [get_ports dummy_out2]
set_output_delay -clock vclk -min 0.0 [get_ports guard_out]
set_output_delay -clock vclk -min 0.0 [get_ports data_out]
set_load 0.01 [get_ports dummy_out0]
set_load 0.01 [get_ports dummy_out1]
set_load 0.01 [get_ports dummy_out2]
set_load 0.01 [get_ports guard_out]
set_load 0.01 [get_ports data_out]
