library (supported_branches_lib) {
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  capacitive_load_unit (1, pf);
  leakage_power_unit : "1nW";
  nom_process : 1.0;
  nom_temperature : 25.0;
  nom_voltage : 1.0;
  slew_lower_threshold_pct_rise : 30.0;
  slew_upper_threshold_pct_rise : 70.0;
  slew_lower_threshold_pct_fall : 30.0;
  slew_upper_threshold_pct_fall : 70.0;
  input_threshold_pct_rise : 50.0;
  output_threshold_pct_rise : 50.0;
  input_threshold_pct_fall : 50.0;
  output_threshold_pct_fall : 50.0;
  slew_derate_from_library : 1.0;

  operating_conditions (typical) {
    process : 1.0;
    temperature : 25.0;
    voltage : 1.0;
  }
  default_operating_conditions : typical;

  lu_table_template (delay_template) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.10");
    index_2 ("0.001, 0.020");
  }

  cell (PARALLEL_X1) {
    area : 1.0;
    pin (A) {
      direction : input;
      capacitance : 0.002;
      rise_capacitance : 0.002;
      fall_capacitance : 0.002;
    }
    pin (Y) {
      direction : output;
      function : "A";
      max_capacitance : 0.050;
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise (delay_template) { values ("0.020, 0.030", "0.040, 0.050"); }
        cell_fall (delay_template) { values ("0.018, 0.028", "0.038, 0.048"); }
        rise_transition (delay_template) { values ("0.015, 0.025", "0.030, 0.040"); }
        fall_transition (delay_template) { values ("0.014, 0.024", "0.029, 0.039"); }
      }
    }
  }

  cell (NEAR_A_X1) {
    area : 1.0;
    pin (A) {
      direction : input;
      capacitance : 0.002;
      rise_capacitance : 0.002;
      fall_capacitance : 0.002;
    }
    pin (Y) {
      direction : output;
      function : "A";
      max_capacitance : 0.050;
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise (delay_template) { values ("0.0200000, 0.0300000", "0.0400000, 0.0500000"); }
        cell_fall (delay_template) { values ("0.0180000, 0.0280000", "0.0380000, 0.0480000"); }
        rise_transition (delay_template) { values ("0.015, 0.025", "0.030, 0.040"); }
        fall_transition (delay_template) { values ("0.014, 0.024", "0.029, 0.039"); }
      }
    }
  }

  cell (NEAR_B_X1) {
    area : 1.0;
    pin (A) {
      direction : input;
      capacitance : 0.002;
      rise_capacitance : 0.002;
      fall_capacitance : 0.002;
    }
    pin (Y) {
      direction : output;
      function : "A";
      max_capacitance : 0.050;
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise (delay_template) { values ("0.0200001, 0.0300001", "0.0400001, 0.0500001"); }
        cell_fall (delay_template) { values ("0.0180001, 0.0280001", "0.0380001, 0.0480001"); }
        rise_transition (delay_template) { values ("0.015, 0.025", "0.030, 0.040"); }
        fall_transition (delay_template) { values ("0.014, 0.024", "0.029, 0.039"); }
      }
    }
  }

  cell (JOIN2_X1) {
    area : 1.2;
    pin (A) {
      direction : input;
      capacitance : 0.003;
      rise_capacitance : 0.003;
      fall_capacitance : 0.003;
    }
    pin (B) {
      direction : input;
      capacitance : 0.003;
      rise_capacitance : 0.003;
      fall_capacitance : 0.003;
    }
    pin (Y) {
      direction : output;
      function : "A | B";
      max_capacitance : 0.050;
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise (delay_template) { values ("0.030, 0.040", "0.050, 0.060"); }
        cell_fall (delay_template) { values ("0.028, 0.038", "0.048, 0.058"); }
        rise_transition (delay_template) { values ("0.020, 0.030", "0.035, 0.045"); }
        fall_transition (delay_template) { values ("0.019, 0.029", "0.034, 0.044"); }
      }
      timing () {
        related_pin : "B";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise (delay_template) { values ("0.030, 0.040", "0.050, 0.060"); }
        cell_fall (delay_template) { values ("0.028, 0.038", "0.048, 0.058"); }
        rise_transition (delay_template) { values ("0.020, 0.030", "0.035, 0.045"); }
        fall_transition (delay_template) { values ("0.019, 0.029", "0.034, 0.044"); }
      }
    }
  }

  cell (NONUNATE2_X1) {
    area : 1.2;
    pin (A) {
      direction : input;
      capacitance : 0.003;
      rise_capacitance : 0.003;
      fall_capacitance : 0.003;
    }
    pin (B) {
      direction : input;
      capacitance : 0.003;
      rise_capacitance : 0.003;
      fall_capacitance : 0.003;
    }
    pin (Y) {
      direction : output;
      function : "A ^ B";
      max_capacitance : 0.050;
      timing () {
        related_pin : "A";
        timing_sense : non_unate;
        timing_type : combinational;
        cell_rise (delay_template) { values ("0.032, 0.042", "0.052, 0.062"); }
        cell_fall (delay_template) { values ("0.031, 0.041", "0.051, 0.061"); }
        rise_transition (delay_template) { values ("0.021, 0.031", "0.036, 0.046"); }
        fall_transition (delay_template) { values ("0.020, 0.030", "0.035, 0.045"); }
      }
      timing () {
        related_pin : "B";
        timing_sense : non_unate;
        timing_type : combinational;
        cell_rise (delay_template) { values ("0.033, 0.043", "0.053, 0.063"); }
        cell_fall (delay_template) { values ("0.032, 0.042", "0.052, 0.062"); }
        rise_transition (delay_template) { values ("0.022, 0.032", "0.037, 0.047"); }
        fall_transition (delay_template) { values ("0.021, 0.031", "0.036, 0.046"); }
      }
    }
  }

  cell (SECONDARY_X1) {
    area : 1.0;
    pin (A) {
      direction : input;
      capacitance : 0.002;
      rise_capacitance : 0.002;
      fall_capacitance : 0.002;
    }
    pin (Y) {
      direction : output;
      function : "A";
      max_capacitance : 0.050;
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise (delay_template) { values ("0.024, 0.034", "0.044, 0.054"); }
        cell_fall (delay_template) { values ("0.022, 0.032", "0.042, 0.052"); }
        rise_transition (delay_template) { values ("0.017, 0.027", "0.032, 0.042"); }
        fall_transition (delay_template) { values ("0.016, 0.026", "0.031, 0.041"); }
      }
    }
  }

  cell (LOOP_X1) {
    area : 1.0;
    pin (A) {
      direction : input;
      capacitance : 0.002;
      rise_capacitance : 0.002;
      fall_capacitance : 0.002;
    }
    pin (Y) {
      direction : output;
      function : "A";
      max_capacitance : 0.050;
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise (delay_template) { values ("0.026, 0.036", "0.046, 0.056"); }
        cell_fall (delay_template) { values ("0.024, 0.034", "0.044, 0.054"); }
        rise_transition (delay_template) { values ("0.018, 0.028", "0.033, 0.043"); }
        fall_transition (delay_template) { values ("0.017, 0.027", "0.032, 0.042"); }
      }
    }
  }

  cell (DISABLE_X1) {
    area : 1.0;
    pin (A) {
      direction : input;
      capacitance : 0.002;
      rise_capacitance : 0.002;
      fall_capacitance : 0.002;
    }
    pin (Y) {
      direction : output;
      function : "A";
      max_capacitance : 0.050;
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise (delay_template) { values ("0.028, 0.038", "0.048, 0.058"); }
        cell_fall (delay_template) { values ("0.026, 0.036", "0.046, 0.056"); }
        rise_transition (delay_template) { values ("0.019, 0.029", "0.034, 0.044"); }
        fall_transition (delay_template) { values ("0.018, 0.028", "0.033, 0.043"); }
      }
    }
  }
}
