create_clock -name clk -period 10.0 [get_ports clk]
set_input_delay -clock clk -max 1.0 [get_ports din]
set_input_delay -clock clk -min 0.2 [get_ports din]
set_input_transition 0.05 [get_ports din]
set_input_delay -clock clk -max 0.02 [get_ports other]
set_input_delay -clock clk -min 0.01 [get_ports other]
set_input_transition 0.04 [get_ports other]
set_input_delay -clock clk -max 0.1 [get_ports reset_n]
set_input_delay -clock clk -min 0.01 [get_ports reset_n]
set_input_transition 0.03 [get_ports reset_n]
set_output_delay -clock clk -max 1.0 [get_ports out]
set_output_delay -clock clk -min 0.2 [get_ports out]
set_load 0.01 [get_ports out]
set_output_delay -clock clk -max 0.5 [get_ports qtap]
set_output_delay -clock clk -min 0.1 [get_ports qtap]
set_load 0.02 [get_ports qtap]
set_propagated_clock [get_clocks clk]
